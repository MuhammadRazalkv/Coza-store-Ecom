      <div class="container">
        <div class="main-body">

          <!--* ----------------------------------------User Profile Start --------------------------------------------  -->
          <!-- *--------------------------------------------------------------------------------------------------------------           -->
          <section class="user-profile footer-padding">
            <div class="container">

              <!-- !------------------------------------- Orders  ---------------------------------------------------------------------  -->

              <div class="container">
                <div class="main-body">
                  <section class="user-profile footer-padding">
                    <div class="container">
                      <div class="user-profile-section">

                        
                        <!-- ===================== ORDERS ===================== -->
                        <div class="tab-pane fade show active" id="v-pills-order">
                          <div class="cart-section">

                            <!-- ===================== TABLE ===================== -->
                            <table class="table">
                              <tbody>

                                <!-- TABLE HEADER -->
                                <tr class="table-row table-top-row">
                                  <td>PRODUCT</td>
                                  <td>PRICE</td>
                                  <td>QUANTITY</td>
                                  <td>TOTAL</td>
                                  <td>Payment</td>
                                  <td>Status</td>
                                  <td>ACTION</td>
                                  <td>View</td>
                                </tr>

                                <% if (orders && orders.length> 0) { %>

                                  <% orders.forEach(order=> { %>
                                    <% order.orderItems.forEach(variant=> { %>

                                      <tr class="table-row">

                                        <!-- PRODUCT -->
                                        <td>
                                          <div class="d-flex align-items-center">
                                            <div>
                                              <% if (variant.variantId?.variantImg?.length> 0) { %>
                                                <img src="<%= variant.variantId.variantImg[0] %>" width="60">
                                                <% } else { %>
                                                  <img src="/assets/productImages/default.jpg" width="60">
                                                  <% } %>
                                            </div>

                                            <div class="ms-2">
                                              <%= variant.variantName %>
                                            </div>
                                          </div>
                                        </td>

                                        <!-- PRICE -->
                                        <td>
                                          <%= variant.variantPrice %>
                                        </td>

                                        <!-- QUANTITY -->
                                        <td>
                                          <%= variant.quantity %>
                                        </td>

                                        <!-- TOTAL -->
                                        <td>
                                          <%= variant.variantPrice * variant.quantity %>
                                        </td>

                                        <!-- PAYMENT -->
                                        <td>
                                          <%= order.paymentMethod %>
                                        </td>

                                        <!-- STATUS -->
                                        <td>
                                          <%= variant.orderStatus %>
                                        </td>

                                        <!-- ACTION -->
                                        <td>
                                          <% if (variant.orderStatus==='Processing' ) { %>

                                            <button class="btn btn-danger btn-sm"
                                              onclick="cancelOrderItem('<%= order._id %>', '<%= variant._id %>')">
                                              Cancel
                                            </button>

                                            <% } else if (variant.orderStatus==='Delivered' ) { %>

                                              <button class="btn btn-warning btn-sm"
                                                onclick="requestReturn('<%= order._id %>', '<%= variant._id %>')">
                                                Return
                                              </button>

                                              <a href="/downloadInvoice?orderId=<%= order._id %>">
                                                <button class="btn btn-primary btn-sm mt-1">
                                                  Invoice
                                                </button>
                                              </a>

                                              <% } else if (variant.orderStatus==='Pending' ) { %>

                                                <button class="btn btn-primary btn-sm"
                                                  onclick="rePayment('<%= order._id %>')">
                                                  Re-pay
                                                </button>

                                                <% } else { %>

                                                  <span>
                                                    <%= variant.orderStatus %>
                                                  </span>

                                                  <% } %>
                                        </td>

                                        <!-- VIEW -->
                                        <td>
                                          <a onclick="viewOrderDetails('<%= order._id %>')">
                                            <i class="zmdi zmdi-eye"></i>
                                          </a>
                                        </td>

                                      </tr>

                                      <% }) %>
                                        <% }) %>

                                          <% } else { %>

                                            <!-- EMPTY STATE -->
                                            <tr>
                                              <td colspan="8" class="text-center">
                                                <h5>No orders found</h5>
                                                <img src="/assets/productImages/Noorders.webp" width="150">
                                              </td>
                                            </tr>

                                            <% } %>

                              </tbody>
                            </table>

                            <!-- ===================== PAGINATION ===================== -->
                            <nav class="d-flex justify-content-end">
                              <ul class="pagination">

                                <!-- PREV -->
                                <% if (page> 1) { %>
                                  <li class="page-item">
                                    <a class="page-link" href="/orders?page=<%= page - 1 %>">
                                      <i class="fas fa-chevron-left"></i>
                                    </a>
                                  </li>
                                  <% } else { %>
                                    <li class="page-item disabled">
                                      <span class="page-link">
                                        <i class="fas fa-chevron-left"></i>
                                      </span>
                                    </li>
                                    <% } %>

                                      <!-- PAGE NUMBERS -->
                                      <% for (let i=1; i <=totalPages; i++) { %>
                                        <li class="page-item <%= i === page ? 'active' : '' %>">
                                          <a class="page-link" href="/orders?page=<%= i %>">
                                            <%= i %>
                                          </a>
                                        </li>
                                        <% } %>

                                          <!-- NEXT -->
                                          <% if (page < totalPages) { %>
                                            <li class="page-item">
                                              <a class="page-link" href="/orders?page=<%= page + 1 %>">
                                                <i class="fas fa-chevron-right"></i>
                                              </a>
                                            </li>
                                            <% } else { %>
                                              <li class="page-item disabled">
                                                <span class="page-link">
                                                  <i class="fas fa-chevron-right"></i>
                                                </span>
                                              </li>
                                              <% } %>

                              </ul>
                            </nav>

                          </div>
                        </div>

                      </div>
                    </div>
                  </section>
                  ```

                </div>
              </div>

            </div>
          </section>
        </div>
      </div>


    <!-- Modal for return request -->
    <div id="returnModal" class="modal">
      <div class="modal-content">
        <div class="modal-header">
          <h4>Request Return</h4>
          <span class="close" onclick="closeModal()">&times;</span>
        </div>
        <form id="returnForm">
          <input type="hidden" id="orderId" name="orderId">
          <input type="hidden" id="variantId" name="variantId">
          <label for="returnReason">Reason for return:</label>
          <select id="returnReason" name="returnReason" required>
            <option value="" disabled selected>Select a reason</option>
            <option value="Wrong item received">Wrong item received</option>
            <option value="Item damaged or defective">Item damaged or defective</option>
            <option value="Item not as described">Item not as described</option>
            <option value="Changed my mind">Changed my mind</option>
            <option value="Other">Other</option>
          </select>
          <button type="submit">Submit</button>
        </form>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.11.1/dist/sweetalert2.all.min.js"></script>

